  email["<b>Email Service</b><br/><i>[transactional email API]</i><br/>alerts & weekly digest"]
  sb["<b>Supabase</b><br/><i>[hosted cloud]</i><br/>logins, users & meeting data"]

  resident -- uses --> cr
  org -- uses --> cr
  admin -- manages --> cr
  cr -- "summarizes docs,<br/>drafts letters" --> ai
  cr -- "pulls meetings<br/>& PDFs (OData)" --> cc
  cr -- "sends alerts<br/>& digest" --> email
  cr -- "checks logins,<br/>reads / writes (SQL)" --> sb

  classDef person fill:#ffffff,stroke:#1e1e1e,stroke-width:2px
  classDef system fill:#fdf3dc,stroke:#1e1e1e,stroke-width:3px
